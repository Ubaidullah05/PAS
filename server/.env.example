# Copy this file to server/.env and adjust the values.
# .env is git-ignored; never commit real secrets.

NODE_ENV=development
PORT=5000

# MongoDB connection string. Required in production.
MONGO_URI=mongodb://127.0.0.1:27017/pas

# Signing key for login tokens. Required in production and must be 32+ characters.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# Only this address is allowed to call the API from a browser.
CLIENT_URL=http://localhost:5173

# Where uploaded documents are stored (created on boot, git-ignored).
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
